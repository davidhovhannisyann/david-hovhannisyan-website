---
/**
 * About Me — short bio, full skill set, languages, education and contact.
 *
 * Contact is LinkedIn only. The phone number and email address from the CV are
 * intentionally not published anywhere on this site.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site, links, portrait, avatar } from '../data/site';
import { skillGroups, languages, education } from '../data/about';
import { yearsExperience } from '../data/experience';
import { url } from '../lib/url';
---

<Base
  title="About Me"
  description={`About ${site.name} — QA Engineer based in ${site.location}. Skills, languages, education and contact.`}
>
  <PageHeader
    eyebrow="About Me"
    title="The person<br />behind the bug reports"
    lead="QA Engineer based in Yerevan, working across mobile and PC games. Applied Mathematics graduate, occasional video editor, and permanently curious about how things break."
    meta={[site.location, `${yearsExperience}+ years experience`]}
  />

  <!-- Bio -->
  <section class="section">
    <div class="container bio">
      <div
        class:list={['bio__portrait', !portrait && avatar && 'bio__portrait--bare']}
        data-reveal
      >
        {
          portrait ? (
            <img
              class="bio__photo"
              src={url(portrait)}
              alt={`${site.name}, ${site.role}`}
              width="900"
              height="1125"
            />
          ) : avatar ? (
            /* Transparent cut-out — no frame, fill or texture behind it. */
            <img
              class="bio__art"
              src={url(avatar)}
              alt={`Illustrated avatar of ${site.name}`}
              width="450"
              height="612"
            />
          ) : (
            /* Fallback when neither a photo nor the avatar is set. */
            <div class="bio__placeholder" aria-hidden="true">
              <span class="bio__dots dots dots--ink" />
              <span class="bio__monogram">{site.initials}</span>
              <span class="bio__caption">{site.role}</span>
            </div>
          )
        }
      </div>

      <div class="bio__copy" data-reveal style="--reveal-delay:90ms">
        <p class="eyebrow">Hello</p>
        <h2 class="h2">I'm {site.name.split(' ')[0]}</h2>

        <div class="bio__text stack">
          <p>
            I'm a Quality Assurance Engineer in {site.location}. I spend my days making
            sure games hold together — designing and running test cases, chasing crashes
            through Firebase and Play Console, poking at APIs with Postman and Charles,
            and automating whatever is worth automating in Java.
          </p>
          <p>
            I came to QA from an engineering background: a Bachelor's in Applied
            Mathematics, then a year building GPU-accelerated tooling in C++, CUDA and
            LabVIEW at Ngene. That's why I'd rather write the internal tool than repeat
            the manual pass a fourth time.
          </p>
          <p>
            Outside of testing, I edit video. Most recently that meant 250+ mobile ad
            creatives and 50+ social videos for Melon Sandbox, a game with over 100
            million downloads — concept through to the final platform-ready cut.
          </p>
        </div>

        <a
          class="btn"
          href={links.linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21H9z"
            ></path>
          </svg>
          {links.linkedin.display}
          <svg
            class="btn__arrow"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M9 7h8v8"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Technical skills</p>
        <h2 class="h2">The full toolkit</h2>
      </div>

      <div class="grid-cards">
        {
          skillGroups.map((group, i) => (
            <div class="skill card" data-reveal style={`--reveal-delay:${i * 55}ms`}>
              <span class="skill__icon">
                <Icon name={group.icon} />
              </span>
              <h3 class="skill__label">{group.label}</h3>
              <ul class="chip-row">
                {group.items.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Languages + Education -->
  <section class="section">
    <div class="container split">
      <div data-reveal>
        <div class="section-head section-head--sm">
          <p class="eyebrow">Languages</p>
          <h2 class="h2">Three, fluently</h2>
        </div>

        <ul class="langs">
          {
            languages.map((language) => (
              <li class="lang">
                <div class="lang__row">
                  <span class="lang__name">{language.name}</span>
                  <span class="lang__level">{language.level}</span>
                </div>
                {/* Decorative meter — the level text above carries the meaning. */}
                <span class="lang__meter" aria-hidden="true">
                  <span class="lang__fill" style={`--pct:${language.proficiency}%`} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--reveal-delay:90ms">
        <div class="section-head section-head--sm">
          <p class="eyebrow">Education</p>
          <h2 class="h2">Where it started</h2>
        </div>

        {
          education.map((entry) => (
            <article class="edu card">
              {entry.logo && (
                <div class="edu__logo">
                  <img
                    src={url(entry.logo)}
                    alt={entry.logoAlt ?? `${entry.institution} logo`}
                    loading="lazy"
                    decoding="async"
                    width="180"
                    height="64"
                  />
                </div>
              )}
              <div class="edu__body">
                <h3 class="edu__school">
                  {entry.institutionUrl ? (
                    <a
                      class="link-underline"
                      href={entry.institutionUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {entry.institution}
                    </a>
                  ) : (
                    entry.institution
                  )}
                </h3>
                <p class="edu__degree">
                  {entry.degree} — {entry.field}
                </p>
                <p class="edu__period">{entry.period}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The contact band that used to sit here was removed: its only content was
       the LinkedIn link, which now lives in the intro above, and the footer
       already carries LinkedIn plus the location on every page. -->
</Base>

<style>
  /* -------------------------------------------------------------- bio -- */
  .bio {
    display: grid;
    gap: clamp(1.75rem, 1rem + 4vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .bio {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    }
  }

  .bio__portrait {
    position: relative;
    inline-size: min(100%, 20rem);
    justify-self: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--c-line);
  }

  /* The avatar is a transparent cut-out, so it gets no frame or fill — only
     the figure, sitting straight on the page background. */
  .bio__portrait--bare {
    border: 0;
    overflow: visible;
  }

  .bio__art {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .bio__photo {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .bio__placeholder {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    block-size: 100%;
    background: linear-gradient(
      160deg,
      var(--c-paper),
      color-mix(in srgb, var(--c-violet) 8%, var(--c-paper))
    );
  }

  .bio__dots {
    position: absolute;
    inset: 0;
    --dot-color: rgb(47 45 46 / 14%);
    --dot-gap: 16px;
  }

  .bio__monogram {
    font-size: clamp(4rem, 3rem + 6vw, 6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    /* Mid-grey rather than the hairline colour, so the placeholder reads as a
       deliberate panel instead of a failed image. */
    -webkit-text-stroke: 2px #a9a6a7;
  }

  .bio__caption {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .bio__copy > * + * {
    margin-block-start: var(--space-md);
  }

  .bio__text {
    --flow: var(--space-md);
    max-inline-size: var(--maxw-prose);
    color: var(--c-muted);
  }

  .bio__copy .btn {
    margin-block-start: var(--space-lg);
  }

  /* ------------------------------------------------------------ skills -- */
  .skill {
    gap: var(--space-sm);
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    block-size: 100%;
  }

  /* Black-to-purple, the same family as the nav, header and footer bands —
     rather than the old blue-to-green, which put a second colour scheme on a
     page that has no section accent of its own. */
  .skill__icon {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    background: var(--grad-purple-diag);
    color: var(--c-white);
  }

  .skill__label {
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ----------------------------------------------- languages + education -- */
  .split {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4rem);
  }

  @media (min-width: 52rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .section-head--sm {
    margin-block-end: var(--space-xl);
  }

  .langs {
    display: grid;
    gap: var(--space-lg);
  }

  .lang__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-block-end: var(--space-xs);
  }

  .lang__name {
    font-size: var(--fs-h3);
    font-weight: 800;
  }

  .lang__level {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .lang__meter {
    display: block;
    block-size: 6px;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
  }

  /* Two stops, matching the toolkit tiles above, instead of the three-colour
     brand gradient that ran blue→green→yellow inside a 6px bar. */
  .lang__fill {
    display: block;
    block-size: 100%;
    inline-size: var(--pct);
    background: var(--grad-purple);
  }

  .edu {
    flex-direction: row;
    align-items: center;
    gap: var(--space-md);
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.5rem);
  }

  .edu__logo {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 5rem;
    block-size: 3.5rem;
    padding: 0.35rem;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
  }

  .edu__logo img {
    max-block-size: 100%;
    inline-size: auto;
    object-fit: contain;
  }

  .edu__school {
    font-size: var(--fs-h3);
    line-height: 1.2;
  }

  .edu__degree {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .edu__period {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

</style>
