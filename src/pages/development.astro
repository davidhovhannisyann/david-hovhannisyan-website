---
/**
 * Development page: engineering roles, plus a placeholder for the project
 * write-ups that aren't ready yet.
 *
 * Experience uses the same RoleEntry bands as QA and Creative. Shared for now
 * rather than by principle — if this page later grows demos, embeds or a
 * different composition, fork RoleEntry instead of bending it.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RoleEntry from '../components/RoleEntry.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { rolesFor } from '../data/experience';

const timeline = rolesFor('development');
const roleCount = `${timeline.length} ${timeline.length === 1 ? 'role' : 'roles'}`;
---

<Base
  title="Development"
  accent="development"
  description="Software development work by David Hovhannisyan — C++, CUDA and LabVIEW engineering at Ngene, internal tooling and automation in Java and Kotlin."
>
  <PageHeader
    eyebrow="Development"
    title="Tools, automation<br />and the things<br />built for fun"
    lead="The engineering side of the work — GPU-accelerated toolkits in C++ and CUDA, internal testing tools in Java and Kotlin, and the things built for the fun of it."
  />

  <!-- Engineering roles -->
  <section class="section section--entries">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="h2">Experience</h2>
        <ul class="chip-row">
          <li class="chip chip--accent">{roleCount}</li>
          <li class="chip chip--accent">C++ · CUDA · Java · Kotlin</li>
        </ul>
      </div>
    </div>

    {/* Outside the container: the alternating bands run edge to edge. */}
    <ol class="entries">
      {timeline.map((role, i) => <RoleEntry role={role} index={i} />)}
    </ol>
  </section>

  <!-- Project write-ups still to come -->
  <div class="section--paper">
    <ComingSoon
      heading="Project write-ups on the way"
      blurb="The roles above cover the professional work. The individual projects — what each one does, how it was built and what came out of it — are still being written up."
      planned={[
        'Internal mobile testing tools built in Java and Kotlin',
        'Selenium WebDriver automation frameworks and page-object patterns',
        'CuLab and NGCV — the GPU and video toolkits worked on at Ngene',
        'Personal side projects and experiments',
      ]}
      tools={['Java', 'Kotlin', 'C++', 'CUDA', 'Selenium WebDriver', 'LibGDX']}
    />
  </div>
</Base>
