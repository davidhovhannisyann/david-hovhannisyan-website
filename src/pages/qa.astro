---
/** QA page: full experience timeline, shipped titles grouped by role, and the QA toolkit. */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RoleCard from '../components/RoleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { rolesFor, yearsExperience } from '../data/experience';
import { projects, projectsVia, platforms } from '../data/projects';
import { skillGroups } from '../data/about';

const timeline = rolesFor('qa');

// Titles are grouped by the role they came through, so Rockbite's live mobile
// games aren't presented as freelance work.
const shipped = [
  {
    key: 'rockbite',
    label: 'At Rockbite Games',
    note: 'Live mobile titles I test as part of the studio team.',
    items: projectsVia('rockbite'),
  },
  {
    key: 'freelance',
    label: 'Freelance',
    note: 'Titles I supported for indie and solo developers, through to release.',
    items: projectsVia('freelance'),
  },
];

// The QA-relevant slice of the toolkit; the full list lives on the About page.
const toolkitLabels = [
  'Test Management',
  'API Testing',
  'Monitoring & Analytics',
  'Programming & Automation',
];
const toolkit = toolkitLabels
  .map((label) => skillGroups.find((group) => group.label === label))
  .filter((group): group is NonNullable<typeof group> => Boolean(group));
---

<Base
  title="QA"
  accent="qa"
  description="David Hovhannisyan's quality assurance experience — game testing at Rockbite Games and freelance QA for indie studios, across Steam, Google Play and itch.io."
>
  <PageHeader
    eyebrow="Quality Assurance"
    title="Finding the bugs<br />before players do"
    lead="Test design, manual and automated execution, API testing and live stability monitoring across mobile and PC games — from indie one-person studios to a full production team."
    meta={[
      `${yearsExperience}+ years`,
      `${timeline.length} roles`,
      `${projects.length} shipped titles`,
    ]}
  />

  <!-- Experience timeline -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Experience</p>
        <h2 class="h2">Where I've done it</h2>
      </div>

      <ol class="timeline">
        {timeline.map((role, i) => <RoleCard role={role} delay={i * 90} />)}
      </ol>
    </div>
  </section>

  <!-- Shipped titles -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Shipped</p>
        <h2 class="h2">Titles out<br /><span class="text-gradient">in the wild</span></h2>
        <p class="lead">
          {projects.length} released titles across {platforms.join(', ')} — each one through
          the same treatment: regression passes, sanity checks, defect reports and fix
          verification right up to release.
        </p>
      </div>

      {
        shipped.map((group) => (
          <div class="shipped-group">
            <div class="shipped-group__head" data-reveal>
              <h3 class="shipped-group__label">{group.label}</h3>
              <span class="shipped-group__count">{group.items.length}</span>
              <p class="shipped-group__note">{group.note}</p>
            </div>

            <div class="grid-cards grid-cards--wide">
              {group.items.map((project, i) => (
                <ProjectCard project={project} delay={i * 70} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Toolkit -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Toolkit</p>
        <h2 class="h2">What I work with</h2>
      </div>

      <div class="grid-cards grid-cards--tight">
        {
          toolkit.map((group, i) => (
            <div class="tool card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <h3 class="tool__label">{group.label}</h3>
              <ul class="chip-row">
                {group.items.map((item) => (
                  <li class="chip chip--accent">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .shipped-group + .shipped-group {
    margin-block-start: clamp(2.5rem, 1.8rem + 2.6vw, 4rem);
  }

  .shipped-group__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    margin-block-end: var(--space-lg);
    padding-block-end: var(--space-sm);
    border-block-end: 2px solid var(--c-line);
  }

  .shipped-group__label {
    font-size: var(--fs-h3);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .shipped-group__count {
    display: grid;
    place-items: center;
    min-inline-size: 1.6rem;
    padding: 0.1rem 0.4rem;
    background: var(--accent);
    color: var(--c-black);
    font-size: var(--fs-xs);
    font-weight: 900;
  }

  /* Pushes the note to its own line once there's room, so it reads as a
     caption rather than crowding the heading. */
  .shipped-group__note {
    flex: 1 1 100%;
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  @media (min-width: 48rem) {
    .shipped-group__note {
      flex: 1 1 auto;
      margin-inline-start: auto;
      text-align: right;
    }
  }

  .tool {
    gap: var(--space-md);
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    block-size: 100%;
  }

  .tool__label {
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-black);
  }
</style>
