---
/**
 * QA page: free-form experience entries and every shipped title in one grid.
 *
 * There's deliberately no toolkit section here — the full skill list lives on
 * the About page, and duplicating it added nothing.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RoleEntry from '../components/RoleEntry.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { rolesFor, yearsExperience } from '../data/experience';
import { orderedProjects, projects, platforms } from '../data/projects';

const timeline = rolesFor('qa');
---

<Base
  title="QA"
  accent="qa"
  description="David Hovhannisyan's quality assurance experience — game testing at Rockbite Games and freelance QA for indie studios, across Steam, Google Play and itch.io."
>
  <PageHeader
    eyebrow="Quality Assurance"
    title="Finding the bugs<br />before players do"
    lead="Test design, manual and automated execution, API testing and live stability monitoring across mobile and PC games — from indie one-person studios to a full production team."
    meta={[
      `${yearsExperience}+ years`,
      `${timeline.length} roles`,
      `${projects.length} shipped titles`,
    ]}
  />

  <!-- Experience -->
  <section class="section section--entries">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Experience</p>
        <h2 class="h2">Where I've done it</h2>
      </div>
    </div>

    {/* Outside the container: the alternating bands run edge to edge. */}
    <ol class="entries">
      {timeline.map((role, i) => <RoleEntry role={role} index={i} />)}
    </ol>
  </section>

  <!-- Shipped titles -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Shipped</p>
        <h2 class="h2">Titles out<br /><span class="text-highlight">in the wild</span></h2>
        <p class="lead">
          {projects.length} released titles across {platforms.join(', ')} — each one through
          the same treatment: regression passes, sanity checks, defect reports and fix
          verification right up to release.
        </p>
      </div>

      <div class="grid-cards grid-cards--wide">
        {
          orderedProjects.map((project, i) => (
            /* Stagger resets every row so later cards don't wait on a long chain. */
            <ProjectCard project={project} delay={(i % 3) * 70} />
          ))
        }
      </div>
    </div>
  </section>
</Base>
