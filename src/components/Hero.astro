---
/**
 * Landing-page hero: dark gradient backdrop with the arc graphic bottom-left,
 * a heavy uppercase statement on the left and the avatar on the right.
 *
 * The frame is the photo slot — set `portrait` in src/data/site.ts and the
 * avatar is replaced by the photo with no other changes needed.
 */
import ArcLines from './ArcLines.astro';
import { site, portrait, avatar } from '../data/site';
import { yearsExperience } from '../data/experience';
import { projects, platforms } from '../data/projects';
import { url } from '../lib/url';

/* Values are kept to short numerals so the row stays inside the copy column —
   a long text value overruns it and collides with the arc graphic. */
const stats = [
  { value: `${yearsExperience}+`, label: 'Years in QA & engineering' },
  { value: String(projects.length), label: 'Titles shipped' },
  { value: String(platforms.length), label: `Stores — ${platforms.join(', ')}` },
];
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <ArcLines />

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--light">{site.role} · {site.location}</p>

      <h1 class="display hero__title">
        I break games<br />
        so players<br />
        <span class="text-gold">don't have to</span>
      </h1>

      <p class="hero__lead">
        Quality Assurance Engineer testing mobile and PC games from the first
        build to the store release — test design, automation, API testing and
        the crash reports nobody else wants to read.
      </p>

      <div class="hero__actions">
        <a class="btn" href={url('/qa')}>
          Explore my QA work
          <svg
            class="btn__arrow"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
        <a class="btn btn--ghost" href={url('/about')}>About me</a>
      </div>

      <dl class="hero__stats">
        {
          stats.map((stat) => (
            <div class="hero__stat">
              <dt class="hero__stat-value">{stat.value}</dt>
              <dd class="hero__stat-label">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero__art" aria-hidden={portrait || avatar ? undefined : 'true'}>
      <div class:list={['frame', !portrait && avatar && 'frame--bare']}>
        {
          portrait ? (
            /* A real photo fills the frame. */
            <img
              class="frame__photo"
              src={url(portrait)}
              alt={`${site.name}, ${site.role}`}
              width="900"
              height="1125"
            />
          ) : avatar ? (
            /* Illustration: a transparent cut-out, so it sits straight on the
               hero gradient with no panel, border or backdrop behind it. */
            <img
              class="frame__art"
              src={url(avatar)}
              alt={`Illustrated avatar of ${site.name}`}
              width="450"
              height="612"
            />
          ) : (
            /* Fallback panel when neither is set. */
            <div class="frame__placeholder">
              <span class="frame__dots dots" />
              <span class="frame__monogram">{site.initials}</span>
              <span class="frame__caption">{site.role}</span>
            </div>
          )
        }
      </div>

      <span class="float-chip float-chip--a">
        <strong>Rockbite Games</strong>
        <span>QA Engineer</span>
      </span>
      <span class="float-chip float-chip--b">
        <strong>{projects.length} titles</strong>
        <span>shipped &amp; live</span>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--c-white);
    /* Leaves room for the fixed nav and stays comfortable on short phones.
       dvh keeps the height stable when mobile browser chrome collapses. */
    padding-block: calc(var(--nav-h) + clamp(2.5rem, 1rem + 7vw, 6rem))
      clamp(3rem, 1.5rem + 6vw, 6rem);
    min-block-size: min(100dvh, 52rem);
    display: grid;
    align-items: center;
  }

  /* Landing-only backdrop: near-black on the right easing to a deep violet on
     the left. Shared with the inner-page headers and the footer. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: var(--grad-night);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 1rem + 6vw, 4.5rem);
    align-items: center;
  }

  /* Side-by-side only once the art has room to be worth showing. */
  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    }
  }

  /* ---------------------------------------------------------------- copy -- */
  .hero__copy > * + * {
    margin-block-start: clamp(1rem, 0.7rem + 1vw, 1.75rem);
  }

  .hero__title {
    text-shadow: 0 2px 24px rgb(20 20 20 / 18%);
  }

  .hero__lead {
    max-inline-size: 46ch;
    font-size: clamp(1rem, 0.95rem + 0.4vw, 1.2rem);
    line-height: 1.6;
    color: rgb(255 255 255 / 88%);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* On phones the buttons stack anyway — make them match width rather than
     sit at two different content-driven sizes. */
  @media (max-width: 30rem) {
    .hero__actions {
      display: grid;
    }
  }

  .hero__actions .btn:first-child {
    --btn-bg: var(--c-white);
    --btn-fg: var(--c-black);
  }

  .hero__actions .btn:first-child:hover {
    --btn-bg: var(--c-gold);
    --btn-fg: var(--c-black);
  }

  .hero__stats {
    display: grid;
    gap: var(--space-md) var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    /* Keeps the row inside the copy column, clear of the arc graphic. */
    max-inline-size: 34rem;
    margin-block-start: clamp(1.75rem, 1rem + 2vw, 2.75rem);
    padding-block-start: clamp(1.25rem, 0.8rem + 1.4vw, 1.75rem);
    border-block-start: 1px solid rgb(255 255 255 / 25%);
  }

  .hero__stat-value {
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-gold);
  }

  .hero__stat-label {
    margin: 0.15rem 0 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 68%);
  }

  /* ----------------------------------------------------------------- art -- */
  .hero__art {
    position: relative;
    justify-self: center;
    inline-size: min(100%, 22rem);
  }

  @media (min-width: 60rem) {
    .hero__art {
      inline-size: min(100%, 25rem);
    }
  }

  /* On phones the art stays, but smaller — it's a portrait of David, not
     decoration, so hiding it would drop the most personal thing on the page.
     The overlapping chips do go: at this width they crowd the figure and their
     text is the same information the stats row already carries. */
  @media (max-width: 34.99rem) {
    .hero__art {
      inline-size: min(100%, 14rem);
      margin-block-start: var(--space-xs);
    }

    /* Scoped to two classes on purpose: the base `.float-chip { display: grid }`
       rule is declared later in this file, so a bare `.float-chip` here would
       lose on source order at equal specificity. */
    .hero__art .float-chip {
      display: none;
    }
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 35%);
    background: rgb(20 20 20 / 22%);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2.5deg);
    transition: transform 400ms var(--ease-out);
  }

  .hero__art:hover .frame {
    transform: rotate(0deg);
  }

  /* The cut-out illustration needs no card around it — strip the frame's
     border, fill and shadow so only the figure shows. The tilt stays: it's
     inherited from `.frame`, so the avatar keeps the same lean and the
     straighten-on-hover motion the panel had. */
  .frame--bare {
    border: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }

  .frame__photo {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .frame__placeholder {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    block-size: 100%;
    background: linear-gradient(160deg, rgb(20 20 20 / 55%), rgb(151 71 255 / 35%));
  }

  .frame__dots {
    position: absolute;
    inset: 0;
    --dot-color: rgb(255 255 255 / 16%);
    --dot-gap: 16px;
  }

  /* Sits on the panel rather than filling it, inset slightly so the figure
     never touches the frame edge.

     Positioned rather than sized with percentages: the placeholder centres via
     `place-content: center`, which sizes its grid track to its CONTENT, so a
     percentage max-inline-size on the image would resolve against a box that
     depends on the image itself and collapse. Insets give it a definite box. */
  /* Fills the frame's 4:5 slot; `contain` keeps the figure's own proportions,
     so the leftover space is simply empty — there's no panel to show through.
     Sized explicitly because `auto` on a replaced element means its intrinsic
     size, which would overflow the slot. */
  .frame__art {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 28px rgb(20 20 20 / 32%));
  }

  .frame__monogram {
    font-size: clamp(4rem, 3rem + 8vw, 7rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgb(255 255 255 / 62%);
  }

  .frame__caption {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 72%);
  }

  /* Small cards that overlap the frame corners. */
  .float-chip {
    position: absolute;
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 1rem;
    background: var(--c-white);
    color: var(--c-black);
    box-shadow: var(--shadow-md);
  }

  .float-chip strong {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .float-chip span {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .float-chip--a {
    inset-block-start: 8%;
    inset-inline-start: -1.25rem;
    border-inline-start: 4px solid var(--c-teal);
  }

  .float-chip--b {
    inset-block-end: 9%;
    inset-inline-end: -1.25rem;
    border-inline-start: 4px solid var(--c-gold);
  }

  @media (prefers-reduced-motion: no-preference) {
    .float-chip {
      animation: bob 6s var(--ease-out) infinite;
    }
    .float-chip--b {
      animation-delay: -3s;
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }
</style>
