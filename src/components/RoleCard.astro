---
/**
 * One entry in the experience timeline: logo, company, meta row and bullets.
 * Sits inside <ol class="timeline"> (styles for the connecting rail live on
 * the page that renders the list).
 */
import type { Role } from '../data/experience';
import { url } from '../lib/url';

interface Props {
  role: Role;
  delay?: number;
}

const { role, delay = 0 } = Astro.props;
---

<li class="role" data-reveal style={`--reveal-delay:${delay}ms`}>
  <span class="role__node" aria-hidden="true"></span>

  <article class="role__card card">
    <header class="role__head">
      <div class="role__identity">
        {
          role.logo ? (
            <div class="role__logo">
              <img
                src={url(role.logo)}
                alt={role.logoAlt ?? `${role.company} logo`}
                loading="lazy"
                decoding="async"
                width="160"
                height="60"
              />
            </div>
          ) : (
            /* Freelance has no logo — a monogram tile keeps the row aligned. */
            <div class="role__logo role__logo--mono" aria-hidden="true">
              {role.company.charAt(0)}
            </div>
          )
        }

        <div class="role__names">
          <h3 class="role__company">
            {
              role.companyUrl ? (
                <a class="link-underline" href={role.companyUrl} target="_blank" rel="noopener noreferrer">
                  {role.company}
                </a>
              ) : (
                role.company
              )
            }
          </h3>
          <p class="role__title">{role.title}</p>
        </div>
      </div>

      <div class="role__badges">
        <span class="chip chip--accent">{role.discipline}</span>
        {role.current && <span class="chip chip--live">Current</span>}
      </div>
    </header>

    <p class="role__meta">
      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="1"></rect>
          <path d="M3 10h18M8 3v4M16 3v4"></path>
        </svg>
        {role.period}
      </span>
      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"></path>
          <circle cx="12" cy="10" r="2.6"></circle>
        </svg>
        {role.location}
      </span>
    </p>

    <ul class="role__bullets">
      {role.bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>

    {role.note && <p class="role__note">{role.note}</p>}
  </article>
</li>

<style>
  .role {
    position: relative;
    /* Room for the rail and node on the left. */
    padding-inline-start: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
  }

  /* Dot on the timeline rail, vertically aligned with the company name. */
  .role__node {
    position: absolute;
    inset-block-start: 2.1rem;
    inset-inline-start: 0;
    inline-size: 0.9rem;
    block-size: 0.9rem;
    background: var(--c-white);
    border: 3px solid var(--accent);
    border-radius: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .role__card {
    gap: var(--space-md);
    padding: clamp(1.25rem, 1rem + 1.1vw, 2rem);
  }

  .role__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .role__identity {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-inline-size: 0;
  }

  .role__logo {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 4.25rem;
    block-size: 3.25rem;
    padding: 0.4rem;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
  }

  .role__logo img {
    max-block-size: 100%;
    inline-size: auto;
    object-fit: contain;
  }

  .role__logo--mono {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--c-white));
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .role__company {
    font-size: var(--fs-h3);
    line-height: 1.2;
  }

  .role__title {
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .role__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .role__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    padding-block: var(--space-sm);
    border-block: 1px solid var(--c-line);
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .role__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .role__bullets {
    display: grid;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .role__bullets li {
    position: relative;
    padding-inline-start: 1.35rem;
  }

  /* Small accent square instead of a disc bullet. */
  .role__bullets li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.62em;
    inset-inline-start: 0;
    inline-size: 6px;
    block-size: 6px;
    background: var(--accent);
  }

  .role__note {
    padding: var(--space-sm) var(--space-md);
    background: var(--c-paper);
    border-inline-start: 3px solid var(--c-gold);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink);
  }

  /* Wide cards can afford a two-column bullet list. Driven by the card's own
     width via the container established on .card. */
  @container (min-width: 44rem) {
    .role__bullets {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem var(--space-xl);
    }
  }
</style>
