---
/**
 * A shipped title.
 *
 * Deliberately short. The card itself is the store link, so there is no
 * "view on…" footer row, and the store blurb stays in the data rather than
 * being rendered — a paragraph each turned eleven titles into 2000px of grid,
 * and the list only grows. What's left is what identifies a title: art, name,
 * platform, developer, release date and genre.
 *
 * That makes the card a fixed five bands tall, whatever the title: art, name,
 * meta, genre row. Anything that would add a sixth belongs somewhere else on
 * the page, not squeezed in here — see `credit` in src/data/projects.ts.
 *
 * Handles two kinds of store art:
 *   banner — wide key art (Steam capsules, itch covers), filling the card head
 *   icon   — a square app icon, centred on a tinted panel so it isn't cropped
 * Both occupy the same 460×215 box, so mixed rows stay on a tidy grid.
 */
import type { Project } from '../data/projects';
import { url } from '../lib/url';

interface Props {
  project: Project;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
const { name, platform, storeUrl, developer, releaseDate, genres, art } = project;

const isIcon = art.type === 'icon';

/**
 * Genres rendered per card. The row is one line by construction, so a fourth
 * chip doesn't wrap — it makes flex shrink every chip in the row, and short
 * ones like "Indie" come out as "Indi…" alongside the long ones. Three is what
 * fits whole at the narrowest four-column card. Every title currently has at
 * most three, so this only bounds the future; raise it and the row still holds
 * one line, it just starts truncating.
 */
const MAX_GENRES = 3;
const shownGenres = genres.slice(0, MAX_GENRES);
---

<article class="proj card card--hoverable" data-reveal style={`--reveal-delay:${delay}ms`}>
  <div class:list={['proj__cover', isIcon && 'proj__cover--icon']}>
    {isIcon && <span class="proj__texture dots dots--ink" aria-hidden="true" />}
    <img
      class:list={['proj__art', isIcon && 'proj__art--icon']}
      src={url(art.src)}
      alt={`${name} store artwork`}
      loading="lazy"
      decoding="async"
      width={isIcon ? 320 : 460}
      height={isIcon ? 320 : 215}
    />
    <span class="proj__platform">{platform}</span>
  </div>

  <div class="proj__body">
    <h3 class="proj__name">
      <a class="proj__link" href={storeUrl} target="_blank" rel="noopener noreferrer">
        {name}
      </a>
    </h3>

    <p class="proj__dev">
      {developer}{releaseDate && ` · ${releaseDate}`}
    </p>

    {/* Genres only. Nothing interactive goes in here — a link inside a row of
        labels reads as another label, and it was the one thing that could push
        the row onto a second line. */}
    <ul class="chip-row proj__genres">
      {shownGenres.map((genre) => <li class="chip">{genre}</li>)}
    </ul>
  </div>
</article>

<style>
  .proj {
    block-size: 100%;
    overflow: hidden;
  }

  .proj__cover {
    position: relative;
    overflow: hidden;
    /* Matches the Steam capsule ratio; icon cards reuse it so rows stay level. */
    aspect-ratio: 460 / 215;
    background: var(--c-paper);
  }

  .proj__art {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .proj:hover .proj__art {
    transform: scale(1.05);
  }

  /* ---- square app icons ------------------------------------------------ */
  .proj__cover--icon {
    display: grid;
    place-items: center;
    background: linear-gradient(
      135deg,
      var(--c-paper),
      color-mix(in srgb, var(--accent) 14%, var(--c-paper))
    );
  }

  .proj__texture {
    position: absolute;
    inset: 0;
    --dot-color: color-mix(in srgb, var(--accent) 22%, transparent);
    --dot-gap: 14px;
  }

  /* Sized from the cover's WIDTH, not its height: the cover gets its height
     from aspect-ratio, which leaves the containing block's height indefinite,
     so a percentage block-size would resolve against the image's own intrinsic
     height and overflow. The cover is 460:215, so 34% of its width lands the
     icon at ~73% of its height. */
  .proj__art--icon {
    inline-size: 34%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 22%;
    box-shadow: var(--shadow-md);
  }

  .proj__platform {
    position: absolute;
    inset-block-start: 0.4rem;
    inset-inline-start: 0.4rem;
    padding: 0.15rem 0.45rem;
    background: rgb(20 20 20 / 82%);
    color: var(--c-white);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ---- body ------------------------------------------------------------ */
  .proj__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.2rem;
    padding: 0.75rem 0.85rem 0.85rem;
  }

  .proj__name {
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .proj__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .proj__link:hover {
    color: var(--accent-text);
  }

  .proj__dev {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  /* Pinned to the bottom so names of one and two lines still leave the genre
     row level across a grid row.

     `nowrap` is the rule, not a hope: the row is exactly one line tall for any
     genre list, so no card can grow a second band and drag its whole grid row
     up in height with it. */
  .proj__genres {
    margin-block-start: auto;
    padding-block-start: 0.5rem;
    flex-wrap: nowrap;
    gap: 0.3rem;
  }

  /* Small enough that three genres fit a narrow card outright. Past that, the
     chips give way rather than the row: `min-inline-size: 0` lets a flex item
     shrink below its text (the default `auto` would refuse and overflow), and
     the ellipsis makes the squeeze look deliberate. Nothing is dropped from
     the markup — only the rendering gives ground. */
  .proj__genres .chip {
    display: block;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    /* The inline padding is trimmed past what the shape needs: at 320px the
       card is at its narrowest and three chips cleared the row by only 3px,
       which a fallback font mid-load could swallow. This buys ~8px. */
    padding: 0.12rem 0.4rem;
    font-size: 0.66rem;
  }
</style>
