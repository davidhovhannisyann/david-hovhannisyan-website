---
/**
 * A shipped title. Handles two kinds of store art:
 *   banner — wide key art (Steam capsules, itch covers), filling the card head
 *   icon   — a square app icon, centred on a tinted panel so it isn't cropped
 * Both occupy the same 460×215 box, so mixed rows stay on a tidy grid.
 */
import type { Project } from '../data/projects';
import { url } from '../lib/url';

interface Props {
  project: Project;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
const { name, platform, storeUrl, developer, releaseDate, genres, blurb, art, credit } = project;

const isIcon = art.type === 'icon';
---

<article class="proj card card--hoverable" data-reveal style={`--reveal-delay:${delay}ms`}>
  <div class:list={['proj__cover', isIcon && 'proj__cover--icon']}>
    {isIcon && <span class="proj__texture dots dots--ink" aria-hidden="true" />}
    <img
      class:list={['proj__art', isIcon && 'proj__art--icon']}
      src={url(art.src)}
      alt={`${name} store artwork`}
      loading="lazy"
      decoding="async"
      width={isIcon ? 320 : 460}
      height={isIcon ? 320 : 215}
    />
    <span class="proj__platform">{platform}</span>
  </div>

  <div class="proj__body">
    <h3 class="proj__name">
      <a class="proj__link" href={storeUrl} target="_blank" rel="noopener noreferrer">
        {name}
      </a>
    </h3>

    <p class="proj__dev">
      by {developer}{releaseDate && ` · ${releaseDate}`}
    </p>

    <p class="proj__blurb">{blurb}</p>

    <ul class="chip-row proj__genres">
      {genres.map((genre) => <li class="chip">{genre}</li>)}
    </ul>

    {
      credit && (
        /* Sits above the stretched card link so it stays independently clickable. */
        <a class="proj__credit" href={credit.href} target="_blank" rel="noopener noreferrer">
          {credit.label}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      )
    }

    <p class="proj__cta" aria-hidden="true">
      View on {platform}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </p>
  </div>
</article>

<style>
  .proj {
    block-size: 100%;
    overflow: hidden;
  }

  .proj__cover {
    position: relative;
    overflow: hidden;
    /* Matches the Steam capsule ratio; icon cards reuse it so rows stay level. */
    aspect-ratio: 460 / 215;
    background: var(--c-paper);
  }

  .proj__art {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .proj:hover .proj__art {
    transform: scale(1.04);
  }

  /* ---- square app icons ------------------------------------------------ */
  .proj__cover--icon {
    display: grid;
    place-items: center;
    background: linear-gradient(
      135deg,
      var(--c-paper),
      color-mix(in srgb, var(--accent) 14%, var(--c-paper))
    );
  }

  .proj__texture {
    position: absolute;
    inset: 0;
    --dot-color: color-mix(in srgb, var(--accent) 22%, transparent);
    --dot-gap: 14px;
  }

  /* Sized from the cover's WIDTH, not its height: the cover gets its height
     from aspect-ratio, which leaves the containing block's height indefinite,
     so a percentage block-size would resolve against the image's own intrinsic
     height and overflow. The cover is 460:215, so 34% of its width lands the
     icon at ~73% of its height. */
  .proj__art--icon {
    inline-size: 34%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 22%;
    box-shadow: var(--shadow-md);
  }

  .proj__platform {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-start: 0.6rem;
    padding: 0.25rem 0.6rem;
    background: rgb(20 20 20 / 82%);
    color: var(--c-white);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---- body ------------------------------------------------------------ */
  .proj__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-xs);
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
  }

  .proj__name {
    font-size: var(--fs-h3);
    line-height: 1.2;
  }

  .proj__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .proj__link:hover {
    color: var(--accent);
  }

  .proj__dev {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .proj__blurb {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--c-muted);
  }

  .proj__genres {
    margin-block-start: auto;
    padding-block-start: var(--space-sm);
  }

  .proj__credit {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-block-start: var(--space-sm);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-muted);
    border-block-end: 1px solid var(--c-line);
    padding-block-end: 2px;
    transition: color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .proj__credit:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .proj__cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: var(--space-sm);
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid var(--c-line);
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .proj__cta svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .proj:hover .proj__cta svg {
    transform: translate(3px, -3px);
  }
</style>
