---
/**
 * Free-form experience entry. Every page's experience list is built from these
 * — RoleCard's compact bordered layout is no longer rendered anywhere, but is
 * kept around for a page that wants to diverge later.
 *
 * Each entry is a full-bleed band. They alternate light / dark, and the dark
 * ones are clipped to a parallelogram so the transition between entries is a
 * diagonal cut rather than a straight seam — the corner-cut device the
 * reference site uses throughout.
 *
 * The logo is FLOATED, not a grid column: the title and description flow
 * alongside it and then continue underneath once they run past its height,
 * which is what a fixed column can't do. Wide wordmarks are the exception —
 * see `wideLogo` below.
 *
 * Colour: an entry with its own `brand` overrides --accent for its whole band,
 * so the role title, bullet marks and note rule take the company's colour
 * rather than the page's. Everything structural still comes from the page.
 */
import type { Role } from '../data/experience';
import { avatar } from '../data/site';
import { url } from '../lib/url';

interface Props {
  role: Role;
  /** Position in the list; odd entries mirror horizontally and go dark. */
  index: number;
}

const { role, index } = Astro.props;
const flipped = index % 2 === 1;

/* A cluster replaces the single figure entirely — three small marks in the
   same column rather than one image. */
const cluster = role.characterCluster;
const character = role.character ?? avatar;
const [charW, charH] = role.characterSize ?? [450, 612];
const scale = role.characterScale ?? 1;
/* Mirror alternate copies of the FALLBACK figure, so the same placeholder
   doesn't look copy-pasted down the page. A role's own image is never
   mirrored: these are real marks now — a flipped Steam logo is just wrong. */
const charFlipX = role.character ? 1 : flipped ? -1 : 1;

const [logoW, logoH] = role.logoSize ?? [348, 774];
/* A 5:1 wordmark like Ngene's floated into the logo column would be a ~26px
   sliver next to a 40px heading. Anything this wide becomes a block above the
   copy instead — read as a masthead, at a size where the type is legible. */
const wideLogo = logoW / logoH >= 2;
// A tilted wordmark reads as a mistake rather than a flourish, so only the
// portrait marks get the lean.
const logoTilt = wideLogo ? 0 : flipped ? 3 : -3;
---

{/* --scale / --flip-x live here, not on the <img>: the inner element reads
    --scale to reserve the character's column, and custom properties only
    inherit downwards. */}
<li
  class="entry"
  data-flip={flipped ? 'true' : 'false'}
  data-tone={flipped ? 'dark' : 'light'}
  data-logo={wideLogo ? 'wide' : 'tall'}
  style={[
    `--flip-x:${charFlipX}`,
    `--scale:${scale}`,
    `--char-tilt:${role.characterTilt ?? 0}deg`,
    role.characterGap && `--char-gap:${role.characterGap}`,
    role.logoGap && `--logo-gap:${role.logoGap}`,
    role.brand && `--accent:${role.brand}`,
  ]
    .filter(Boolean)
    .join('; ')}
>
  <div class="entry__inner container">
    {
      role.logo ? (
        <img
          class="entry__logo"
          src={url(role.logo)}
          alt={role.logoAlt ?? `${role.company} logo`}
          style={`--tilt:${logoTilt}deg`}
          loading="lazy"
          decoding="async"
          width={logoW}
          height={logoH}
        />
      ) : (
        /* No mark of its own — a type lockup fills the same column so the
           entry doesn't look like it's missing an asset. */
        <span class="entry__logo entry__mark" style={`--tilt:${logoTilt}deg`} aria-hidden="true">
          <span class="entry__mark-initial">{role.company.charAt(0)}</span>
          <span class="entry__mark-word">{role.company}</span>
        </span>
      )
    }

    <div class="entry__identity">
      <h3 class="entry__company">
        {
          role.companyUrl ? (
            <a class="link-underline" href={role.companyUrl} target="_blank" rel="noopener noreferrer">
              {role.company}
            </a>
          ) : (
            role.company
          )
        }
        {role.current && <span class="entry__live">Current</span>}
      </h3>
      <p class="entry__role">{role.title}</p>
      {/* A role with no `period` shows location alone — the separator rule is
          `span + span`, so it drops out on its own rather than leaving a
          dangling dash. */}
      <p class="entry__meta">
        {role.period && <span>{role.period}</span>}
        <span>{role.location}</span>
      </p>
    </div>

    <div class="entry__body">
      <ul class="entry__points">
        {role.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      {role.note && <p class="entry__note">{role.note}</p>}
    </div>

    {
      cluster ? (
        <div class="entry__cluster" aria-hidden="true">
          {cluster.map((mark) => (
            <img
              class="entry__mark-img"
              src={url(mark.src)}
              alt=""
              style={`--tilt:${mark.tilt ?? 0}deg`}
              loading="lazy"
              decoding="async"
              width={mark.size[0]}
              height={mark.size[1]}
            />
          ))}
        </div>
      ) : (
        <img
          class="entry__char"
          src={url(character)}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          width={charW}
          height={charH}
        />
      )
    }
  </div>
</li>

<style>
  .entry {
    --cut: clamp(1.25rem, 3.5vw, 3.5rem);
    position: relative;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
    /* The art column deliberately sits out in the page gutter, so its painted
       edge lands on the viewport edge exactly — and sub-pixel rounding there
       was enough to give the document a horizontal scrollbar. The overhang
       reservations below do the real work of keeping the art in frame; this
       just stops the last fraction of a pixel from scrolling the page.
       `clip` rather than `hidden`: no scroll container, no effect on the
       vertical axis, which the dark bands' negative margins rely on. */
    overflow-x: clip;

    /* An entry with its own brand colour sets --accent inline, so the deepened
       companion has to be re-derived here — global.css computes it from the
       page's accent, one level up, and a var() reference is substituted where
       it is declared rather than where it is read. */
    --accent-text: color-mix(in srgb, var(--accent) 72%, var(--c-black));
  }

  /* Dark bands carry the diagonal. Both edges slant the same way, so the band
     is a parallelogram and each transition reads as one continuous cut.
     The negative margin pulls neighbours into the sloped area so no wedge of
     empty page shows through. */
  .entry[data-tone='dark'] {
    background: var(--grad-night);
    clip-path: polygon(0 0, 100% var(--cut), 100% 100%, 0 calc(100% - var(--cut)));
    margin-block: calc(var(--cut) * -1);
    padding-block: calc(clamp(3rem, 2rem + 4vw, 5.5rem) + var(--cut));

    /* Redefining the tokens flips every child at once — text, rules, chips —
       without each one needing its own dark-mode rule. */
    --c-ink: var(--c-white);
    --c-muted: rgb(255 255 255 / 72%);
    --c-line: rgb(255 255 255 / 22%);
    /* The raw colour is already legible here, so skip the deepening. Repeated
       from global.css because the .entry rule above is more specific once
       Astro has scoped it. */
    --accent-text: var(--accent);
    color: var(--c-white);
  }

  /* `flow-root` contains the float without clipping the character, which
     `overflow: hidden` would.
     The padding reserves a column on the character's side — that, rather than
     a text width cap, is what guarantees copy never runs underneath it. The
     small surplus over the art's own width is the whole gap between them, so
     the figure crowds the text without ever touching a line. */
  .entry__inner {
    --char-w: calc(clamp(5rem, 9vw, 7.5rem) * var(--scale, 1));
    /* --char-gap is the per-role top-up, for art with no transparent margin
       of its own. It widens the reserved column, so the copy moves away from
       the image rather than the image moving off the page edge. */
    /* Rotating the art widens its PAINTED box well beyond its layout box: a
       192px square at 36deg paints 268px. Left unreserved, that extra ran
       under the copy on one side and off the page on the other — a sideways
       scrollbar between roughly 770px and 1100px wide.
       Derived from the tilt rather than hand-tuned, so changing --char-tilt
       can't quietly reintroduce it. max(sin, -sin) stands in for abs(), which
       is younger than the trig functions. Resolves to 0px at 0deg. */
    --art-overhang: calc(
      var(--char-w) *
        (
          cos(var(--char-tilt, 0deg)) +
            max(sin(var(--char-tilt, 0deg)), -1 * sin(var(--char-tilt, 0deg))) - 1
        ) / 2
    );
    --char-zone: calc(
      var(--char-w) + clamp(0.75rem, 1.5vw, 1.5rem) + var(--char-gap, 0px) +
        2 * var(--art-overhang)
    );
    display: flow-root;
    position: relative;
    padding-inline-end: var(--char-zone);
    /* The measure is this width minus the logo and the character column, so
       widening here is what lengthens the lines. Capping the text in `ch`
       instead only bound one side, which left the character 126px adrift on
       unflipped entries and 19px away on flipped ones. */
    max-inline-size: min(100%, 64rem);
  }

  .entry[data-flip='true'] .entry__inner {
    padding-inline: var(--char-zone) 0;
  }

  /* -------------------------------------------------------------- logo -- */
  /* Floated so the copy wraps beside it and then continues underneath. */
  .entry__logo {
    --logo-w: clamp(5rem, 10vw, 8.5rem);
    /* Per-role top-up on the gap, for marks cropped tight to their artwork. */
    --logo-space: calc(clamp(1.25rem, 3vw, 2.5rem) + var(--logo-gap, 0px));
    /* Same rotation maths as --art-overhang. A 3deg lean is small, but on a
       flipped entry the logo floats against the container's outer edge, so
       even 2.6px of surplus hung off the page and gave the whole document a
       horizontal scrollbar between roughly 780px and 900px wide. */
    --logo-overhang: calc(
      var(--logo-w) *
        (cos(var(--tilt)) + max(sin(var(--tilt)), -1 * sin(var(--tilt))) - 1) / 2
    );
    float: left;
    inline-size: var(--logo-w);
    block-size: auto;
    margin-inline-end: var(--logo-space);
    margin-block-end: clamp(0.75rem, 2vw, 1.5rem);
    object-fit: contain;
    rotate: var(--tilt);
    /* Slow, eased settle. The shared --dur (220ms) is tuned for buttons and
       made this snap. */
    transition: rotate 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .entry[data-flip='true'] .entry__logo {
    float: right;
    margin-inline: var(--logo-space) var(--logo-overhang);
  }

  /* Triggered by the logo itself, not the whole entry — hovering anywhere in
     a block this size shouldn't set the artwork moving. */
  .entry__logo:hover {
    rotate: 0deg;
  }

  /* Wide wordmarks (Ngene's is 5:1) come out of the float entirely: at the
     column's width they'd be a couple of dozen pixels tall, with the copy
     wrapping around a sliver. As a block above the heading they get to run
     wide enough to read, and the copy below keeps its full measure. */
  .entry[data-logo='wide'] .entry__logo,
  .entry[data-flip='true'][data-logo='wide'] .entry__logo {
    float: none;
    inline-size: clamp(9rem, 24vw, 15rem);
    margin-inline: 0;
    margin-block-end: clamp(1rem, 2.2vw, 1.75rem);
  }

  /* Nothing wraps beside it, so the lift replaces the straighten as the
     hover response. */
  .entry[data-logo='wide'] .entry__logo {
    transition: translate 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .entry[data-logo='wide'] .entry__logo:hover {
    translate: 0 -4px;
  }

  /* Type lockup stand-in, sized to the same column. */
  .entry__mark {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.35rem;
    aspect-ratio: 348 / 620;
    padding: 0.75rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 2px solid color-mix(in srgb, var(--accent) 40%, transparent);
    /* Same cut-corner motif as the bands. */
    clip-path: polygon(0 0, 100% 0, 100% 82%, 82% 100%, 0 100%);
  }

  .entry__mark-initial {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    line-height: 1;
    color: var(--accent-text);
  }

  .entry__mark-word {
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--accent-text);
  }

  /* ---------------------------------------------------------- identity -- */
  .entry__company {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  /* Status, not brand — this stays green whatever colour the entry carries.
     Deep forest green on a green wash: the old mid-green on a near-white tint
     was too light to read at this size. */
  .entry__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.25rem 0.6rem;
    background: color-mix(in srgb, var(--c-green) 22%, transparent);
    color: color-mix(in srgb, var(--c-green) 65%, var(--c-black));
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .entry__live::before {
    content: '';
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-green) 70%, var(--c-black));
  }

  /* On a dark band the same treatment disappears — go the other way and lift
     the green off the background instead of pushing it into it. */
  .entry[data-tone='dark'] .entry__live {
    background: color-mix(in srgb, var(--c-green) 24%, transparent);
    color: color-mix(in srgb, var(--c-green) 55%, var(--c-white));
  }

  .entry[data-tone='dark'] .entry__live::before {
    background: var(--c-green);
  }

  .entry__role {
    margin-block-start: 0.45rem;
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.1rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    margin-block-start: 0.3rem;
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .entry__meta span + span::before {
    content: '';
    display: inline-block;
    inline-size: 1.15rem;
    block-size: 1px;
    margin-inline-end: 0.85rem;
    vertical-align: middle;
    background: var(--c-line);
  }

  /* -------------------------------------------------------------- body -- */
  .entry__body {
    margin-block-start: clamp(1rem, 2vw, 1.5rem);
  }

  /* Tight enough to read as one description rather than separate statements,
     with the measure capped so lines never reach the character. */
  .entry__points {
    display: grid;
    gap: 0.3rem;
    font-size: clamp(0.95rem, 0.92rem + 0.15vw, 1.05rem);
    line-height: 1.65;
    color: var(--c-muted);
  }

  /* Follows the entry's colour rather than a fixed yellow, so a Rockbite band
     doesn't carry a gold rule next to red type. */
  .entry__note {
    margin-block-start: clamp(0.9rem, 1.6vw, 1.25rem);
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--accent);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink);
  }

  /* --------------------------------------------------------------- art -- */
  /* Sits in the space the capped measure leaves, leaning in far enough to
     crowd the text without ever overlapping a line of it. */
  /* Anchored to the bottom of the content box, not past it — a negative offset
     pushes it into the band's sloped edge and the clip-path shears it off. */
  /* rotate and scale are separate properties rather than one transform, so a
     per-role tilt can be set without the mirroring having to know about it.
     They compose in a fixed order — translate, rotate, scale — so the lean
     reads in the authored direction whether or not the figure is mirrored. */
  /* One figure or a cluster of marks — either way it occupies the same
     reserved column, anchored to the band's bottom outer corner. */
  .entry__char,
  .entry__cluster {
    position: absolute;
    inset-block-end: 0;
    /* Pulled in by the overhang so the ROTATED edge sits flush with the
       container, rather than the un-rotated one sitting flush and the
       rotated corner hanging off the page. */
    inset-inline-end: var(--art-overhang);
    inline-size: var(--char-w);
  }

  .entry__char {
    block-size: auto;
    rotate: var(--char-tilt, 0deg);
    scale: var(--flip-x) 1;
    filter: drop-shadow(0 12px 22px rgb(20 20 20 / 20%));
    transition: translate 700ms cubic-bezier(0.22, 1, 0.36, 1),
      rotate 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .entry[data-flip='true'] .entry__char,
  .entry[data-flip='true'] .entry__cluster {
    inset-inline: var(--art-overhang) auto;
  }

  /* Triangle: two marks across the top, the third centred beneath them. Three
     square logos this way stand about as tall as the single figure they
     replace, instead of running down the band as a column. */
  .entry__cluster {
    /* Has to clear the rotation, not just the boxes: tilting a mark by 8deg
       widens its footprint by about 13% of its own width, so roughly 11px of
       any gap is eaten before the marks are visibly apart at all.

       Flat rather than fluid, unlike most spacing here. The cluster is within
       a few percent of the same width at every breakpoint — it is capped by
       its own clamp, not by the viewport — so a vw-scaled gap only bottomed
       out on phones and put the marks back to touching. */
    --cluster-gap: 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--cluster-gap);
    justify-items: center;
    /* The group's own lean, on top of each mark's. They compound — a mark at
       -8 inside a cluster at +6 reads as -2 — which is the point: the trio
       tilts as one object rather than three that happen to agree. Rotates
       about its centre, so it stays in its slot instead of swinging out of it. */
    rotate: var(--char-tilt, 0deg);
  }

  .entry__mark-img {
    inline-size: 100%;
    block-size: auto;
    rotate: var(--tilt, 0deg);
    filter: drop-shadow(0 8px 16px rgb(20 20 20 / 22%));
    transition: translate 700ms cubic-bezier(0.22, 1, 0.36, 1),
      rotate 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Spans both columns but is sized to one, so it centres under the pair
     rather than sitting wider than either of them. */
  .entry__mark-img:nth-child(3) {
    grid-column: 1 / -1;
    inline-size: calc(50% - var(--cluster-gap) / 2);
  }

  /* Each mark answers for itself, like the logos and the figure do. */
  .entry__mark-img:hover {
    translate: 0 -5px;
    rotate: 0deg;
  }

  /* Same rule as the logo: the figure reacts to itself, not to the entry
     around it. It sits in the reserved gutter, clear of any text, so accepting
     pointer events here can't interfere with selecting the copy.
     Lifts and straightens together — the same gesture the logos make. */
  .entry__char:hover {
    translate: 0 -6px;
    rotate: 0deg;
  }

  /* ------------------------------------------------------------- stack -- */
  @media (max-width: 47.99rem) {
    /* The character stacks below instead of sitting in a side column, so the
       column reserved for it goes away. The page gutter has to be restated
       rather than zeroed, though — this element is also a .container, and
       dropping its padding outright ran every line of copy into the screen
       edge. Same expression as .container's own rule. */
    .entry__inner,
    .entry[data-flip='true'] .entry__inner {
      padding-inline: max(var(--gutter), env(safe-area-inset-left));
    }

    /* A float this wide would leave one-word lines beside it, so the logo
       becomes a normal block and the copy runs full width underneath. */
    .entry__logo,
    .entry[data-flip='true'] .entry__logo {
      float: none;
      margin-inline: 0;
      inline-size: clamp(4.5rem, 26vw, 7rem);
    }

    /* Wordmarks are already blocks at every width; they only need to give up
       some of their desktop size here. */
    .entry[data-logo='wide'] .entry__logo,
    .entry[data-flip='true'][data-logo='wide'] .entry__logo {
      inline-size: clamp(8rem, 46vw, 12rem);
    }

    .entry__char,
    .entry__cluster {
      position: static;
      inline-size: calc(clamp(5.5rem, 30vw, 8rem) * var(--scale));
      margin: clamp(1.25rem, 4vw, 2rem) auto 0;
    }

    .entry__char {
      display: block;
    }
  }
</style>
