---
/**
 * Site navigation — links only, no logo and no call-to-action.
 *
 * Desktop (≥60rem): a centred horizontal row of links.
 * Mobile (<60rem):  the links collapse into a toggleable dropdown panel, driven
 *                   by a hamburger button pinned to the right of the bar.
 *
 * The bar starts transparent over the gradient header and picks up the main
 * gradient once the page is scrolled, which is why every page begins with a
 * coloured header block.
 *
 * Accessibility: the toggle is a real <button> with aria-expanded/aria-controls,
 * Escape closes the panel and returns focus to the toggle, focus is trapped
 * inside the open panel, and background scrolling is locked while it is open.
 */
import { nav } from '../data/site';
import { url, isActive } from '../lib/url';

const currentPath = Astro.url.pathname;
---

<header class="site-nav" id="site-nav" data-scrolled="false">
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="site-nav__inner container">
    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
    >
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="nav-panel" id="nav-panel" aria-label="Main">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a
                class="nav-link"
                href={url(item.href)}
                data-accent={item.accent}
                aria-current={isActive(currentPath, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    /* Clear the notch on landscape iPhones. */
    padding-inline: max(0px, env(safe-area-inset-left));
    transition: background var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  /* Solid state, applied by the scroll listener and whenever the mobile
     panel is open (an open dropdown needs an opaque backdrop). Carries the
     main gradient rather than white, so the bar reads as part of the page
     instead of a separate chrome strip. At the top it stays transparent. */
  .site-nav[data-scrolled='true'],
  .site-nav:has(#nav-toggle[aria-expanded='true']) {
    background: var(--grad-night);
    box-shadow: 0 1px 0 rgb(255 255 255 / 10%), 0 8px 24px rgb(0 0 0 / 28%);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    /* Only the toggle is in normal flow on mobile — pin it to the right. */
    justify-content: flex-end;
    min-block-size: var(--nav-h);
  }

  /* ------------------------------------------------------------- toggle -- */
  .nav-toggle {
    display: grid;
    place-items: center;
    /* 44×44 — the minimum comfortable touch target. */
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    z-index: 2;
  }

  .nav-toggle__bars {
    display: grid;
    gap: 5px;
    inline-size: 1.5rem;
  }

  .nav-toggle__bars span {
    display: block;
    block-size: 2px;
    inline-size: 100%;
    background: var(--c-white);
    transition: transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  /* Hamburger morphs into an X */
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* --------------------------------------------------- panel (mobile) -- */
  /* Mobile-first: the panel is a dropdown sheet below the bar. */
  .nav-panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    padding: var(--space-md) var(--gutter) calc(var(--space-xl) + env(safe-area-inset-bottom));
    background: var(--grad-night);
    box-shadow: var(--shadow-lg);
    border-block-start: 1px solid rgb(255 255 255 / 14%);

    /* Collapsed by default. visibility keeps it out of the tab order. */
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.75rem);
    transition: opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out), visibility var(--dur) linear;
    /* Very short phones can still reach every item. */
    max-block-size: calc(100dvh - var(--nav-h));
    overflow-y: auto;
  }

  .site-nav:has(#nav-toggle[aria-expanded='true']) .nav-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .nav-list {
    display: grid;
    gap: 0.15rem;
  }

  .nav-link {
    display: block;
    padding: 0.85rem 0.25rem;
    border-block-end: 1px solid rgb(255 255 255 / 14%);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--c-white);
    transition: color var(--dur) var(--ease-out),
      padding-inline-start var(--dur) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--c-blue);
    padding-inline-start: 0.75rem;
  }

  .nav-link[data-accent='qa']:hover,
  .nav-link[data-accent='qa'][aria-current='page'] {
    color: var(--c-blue);
  }
  .nav-link[data-accent='creative']:hover,
  .nav-link[data-accent='creative'][aria-current='page'] {
    color: var(--c-red);
  }
  .nav-link[data-accent='development']:hover,
  .nav-link[data-accent='development'][aria-current='page'] {
    color: var(--c-green);
  }

  /* -------------------------------------------------- panel (desktop) -- */
  @media (min-width: 60rem) {
    .nav-toggle {
      display: none;
    }

    /* With no logo or CTA the link row is the only content — centre it. */
    .site-nav__inner {
      justify-content: center;
    }

    .nav-panel {
      /* Unwind every mobile-sheet property back to an inline row. */
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      padding: 0;
      background: transparent;
      box-shadow: none;
      border: 0;
      max-block-size: none;
      overflow: visible;
    }

    .nav-list {
      display: flex;
      align-items: center;
      gap: clamp(1.25rem, 0.4rem + 2vw, 2.75rem);
    }

    .nav-link {
      position: relative;
      padding: 0.35rem 0;
      border: 0;
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--c-white);
    }

    .nav-link:hover,
    .nav-link[aria-current='page'] {
      padding-inline-start: 0;
      color: var(--c-white);
    }

    /* The mobile rules tint the active link with its section accent, which is
       right on a white sheet but not over the gradient — Development's blue on
       a blue background all but disappears. Keep desktop links white and let
       the underline below carry the accent. */
    .nav-link[data-accent]:hover,
    .nav-link[data-accent][aria-current='page'] {
      color: var(--c-white);
    }

    /* Accent underline wipes in on hover / marks the current page. */
    .nav-link::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      inset-block-end: 0;
      block-size: 3px;
      background: var(--c-yellow);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--dur) var(--ease-out);
    }

    .nav-link:hover::after,
    .nav-link[aria-current='page']::after {
      transform: scaleX(1);
    }

    .nav-link[data-accent='qa']::after {
      background: var(--c-blue);
    }
    .nav-link[data-accent='creative']::after {
      background: var(--c-red);
    }
    .nav-link[data-accent='development']::after {
      background: var(--c-green);
    }

    /* No dark-text flip on scroll any more — the bar stays dark, so the
       links stay white and the accent underline keeps carrying the state. */
  }
</style>

<script>
  const bar = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const panel = document.getElementById('nav-panel')!;

  const DESKTOP = window.matchMedia('(min-width: 60rem)');

  const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    // Stop the page behind the dropdown from scrolling while it is open.
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle.addEventListener('click', () => setOpen(!isOpen()));

  // Escape closes the panel and hands focus back to the toggle.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle.focus();
    }
  });

  // Tapping a link navigates; close first so the panel isn't mid-transition.
  panel.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a') && isOpen()) setOpen(false);
  });

  // Clicking outside the header dismisses the panel.
  document.addEventListener('click', (e) => {
    if (isOpen() && !bar.contains(e.target as Node)) setOpen(false);
  });

  // Keep focus inside the open panel.
  panel.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !isOpen()) return;
    const focusable = panel.querySelectorAll<HTMLElement>('a[href], button');
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      toggle.focus();
    }
  });

  // Resizing up to desktop must not leave the body scroll-locked.
  DESKTOP.addEventListener('change', (e) => {
    if (e.matches && isOpen()) setOpen(false);
  });

  // Swap the bar to its solid state once the header block is behind it.
  const onScroll = () => {
    bar.dataset.scrolled = String(window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
