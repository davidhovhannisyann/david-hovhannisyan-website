---
/**
 * Site footer — dark band with the LinkedIn call-to-action, section links and
 * a small colophon. LinkedIn is the only contact channel published here.
 */
import { nav, site, links } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
const sections = nav.filter((item) => item.href !== '/');
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__lead">
      <p class="eyebrow eyebrow--light">Get in touch</p>
      <p class="h2 site-footer__title">
        Let's talk about<br /><span class="text-gold">quality</span>
      </p>
      <a
        class="btn btn--ghost"
        href={links.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21H9z"
          ></path>
        </svg>
        Connect on LinkedIn
        <svg
          class="btn__arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path d="M7 17 17 7M9 7h8v8"></path>
        </svg>
      </a>
    </div>

    <div class="site-footer__cols">
      <div>
        <h2 class="site-footer__label">Sections</h2>
        <ul class="site-footer__links">
          {
            sections.map((item) => (
              <li>
                <a href={url(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="site-footer__label">Elsewhere</h2>
        <ul class="site-footer__links">
          <li>
            <a href={links.linkedin.href} target="_blank" rel="noopener noreferrer">
              LinkedIn — {links.linkedin.display}
            </a>
          </li>
        </ul>
        <p class="site-footer__location">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"></path>
            <circle cx="12" cy="10" r="2.6"></circle>
          </svg>
          {site.location}
        </p>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {site.name}</p>
    <p class="site-footer__built">{site.role} · Built with Astro</p>
  </div>
</footer>

<style>
  /* Same dark gradient as the hero and the inner-page headers. No decoration:
     the arc graphic is reserved for the top of a page. */
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--grad-night);
    color: var(--c-white);
    padding-block-start: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .site-footer__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4rem);
  }

  /* Two columns only once there is genuinely room for them. */
  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .site-footer__lead > * + * {
    margin-block-start: var(--space-md);
  }

  .site-footer__title {
    line-height: 0.98;
  }

  .site-footer__cols {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }

  .site-footer__label {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-gold);
    margin-block-end: var(--space-md);
  }

  .site-footer__links {
    display: grid;
    font-size: var(--fs-sm);
  }

  /* Anchors are flex boxes with a 2.5rem minimum so each one is a comfortable
     tap target on a phone — a bare inline link is only ~17px tall. */
  .site-footer__links a {
    display: flex;
    align-items: center;
    min-block-size: 2.5rem;
    color: rgb(255 255 255 / 72%);
    transition: color var(--dur) var(--ease-out);
  }

  .site-footer__links a:hover {
    color: var(--c-white);
  }

  .site-footer__location {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: var(--space-lg);
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 55%);
  }

  .site-footer__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
    margin-block-start: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-block: var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
    border-block-start: 1px solid rgb(255 255 255 / 14%);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 50%);
  }

  .site-footer__built {
    color: rgb(255 255 255 / 35%);
  }
</style>
