---
/**
 * Header band for the inner pages. Same treatment as the landing hero — dark
 * gradient with the arc graphic bottom-left — but shorter, so the fixed nav
 * always starts over colour.
 *
 * The arc is absolutely positioned and clipped, so adding it does not change
 * this band's height.
 */
import ArcLines from './ArcLines.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Optional short facts rendered as chips under the lead. */
  meta?: string[];
}

const { eyebrow, title, lead, meta = [] } = Astro.props;
---

<section class="page-header">
  <div class="page-header__bg" aria-hidden="true"></div>
  {/* Taller and pushed further left than the hero's: this band is about half
      the height, so the graphic needs more overshoot to read at the same scale. */}
  <ArcLines
    height="200%"
    shift="-50%"
    heightSm="150%"
    shiftSm="-58%"
    opacitySm="0.4"
  />

  <div class="container page-header__inner">
    <p class="eyebrow eyebrow--light">{eyebrow}</p>
    <h1 class="h1 page-header__title" set:html={title} />
    {lead && <p class="page-header__lead">{lead}</p>}
    {
      meta.length > 0 && (
        <ul class="page-header__meta">
          {meta.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .page-header {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--c-white);
    padding-block: calc(var(--nav-h) + clamp(2.5rem, 1.5rem + 5vw, 5rem))
      clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .page-header__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: var(--grad-night);
  }

  .page-header__inner > * + * {
    margin-block-start: var(--space-md);
  }

  .page-header__title {
    max-inline-size: 20ch;
    text-shadow: 0 2px 20px rgb(20 20 20 / 16%);
  }

  .page-header__lead {
    max-inline-size: 52ch;
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.15rem);
    line-height: 1.6;
    color: rgb(255 255 255 / 88%);
  }

  .page-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-lg);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 78%);
  }

  .page-header__meta li {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  /* Gold bullet between items, but not before the first one. */
  .page-header__meta li + li::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    background: var(--c-gold);
    flex: none;
  }
</style>
